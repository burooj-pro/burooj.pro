{
  "name": "burooj-pro",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3001",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "convert-hero-video": "node scripts/convert-hero-to-mp4.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "imports": {
    "#app": "./.nuxt/dist/app/index.mjs",
    "#app/*": "./.nuxt/dist/app/*",
    "#build": "./.nuxt/dist/server/index.mjs",
    "#build/*": "./.nuxt/dist/server/*",
    "#imports": "./.nuxt/dist/app/imports.mjs",
    "#internal/nitro": "./.nuxt/dist/server/index.mjs",
    "#internal/nitro/*": "./.nuxt/dist/server/*",
    "#internal/nuxt": "./.nuxt/dist/server/index.mjs",
    "#internal/nuxt/*": "./.nuxt/dist/server/*",
    "#internal/nuxt/paths": "./.nuxt/dist/server/paths.mjs",
    "#nuxt": "./.nuxt/dist/app/index.mjs",
    "#nuxt/*": "./.nuxt/dist/app/*"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.2",
    "@vue/test-utils": "^2.4.8",
    "eslint": "^9.39.4",
    "ffmpeg-static": "^5.2.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "sharp": "^0.33.5",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/tailwindcss": "6.12.1",
    "gsap": "^3.13.0",
    "nuxt": "^3.15.4",
    "vue-i18n": "^11.2.2"
  }
}
